// Modul iam (PLAN §4) — akun terhubung ke Supabase Auth, satu role per akun (D-028), grant izin (§4.2).
// Password TIDAK disimpan di sini (Supabase Auth, D-005). Tidak ada FK ke auth.users (D-023).

enum Role {
  SUPER_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE

  @@schema("iam")
}

// PLAN §4.2: daftar tetap; harus sama dengan PERMISSIONS di packages/shared/src/permissions.ts.
enum Permission {
  EMPLOYEE_PERSONAL_READ     @map("employee.personal.read")
  EMPLOYEE_PERSONAL_WRITE    @map("employee.personal.write")
  EMPLOYEE_BANK_READ         @map("employee.bank.read")
  EMPLOYEE_BANK_WRITE        @map("employee.bank.write")
  EMPLOYEE_DOCUMENTS_READ    @map("employee.documents.read")
  EMPLOYEE_DOCUMENTS_WRITE   @map("employee.documents.write")
  CONTRACT_MANAGE            @map("contract.manage")
  PAYROLL_PERIOD_PREPARE     @map("payroll.period.prepare")
  // D-047: review data onboarding calon.
  EMPLOYEE_ONBOARDING_REVIEW @map("employee.onboarding.review")
  // D-054 / OD-6: pengajuan perubahan data karyawan.
  EMPLOYEE_CHANGES_REVIEW    @map("employee.changes.review")

  @@schema("iam")
}

model Account {
  id                  String    @id @default(uuid()) @db.Uuid
  // UUID user Supabase Auth. User Auth tidak pernah dihapus, hanya dinonaktifkan (PLAN §3.2.7).
  authUserId          String    @map("auth_user_id") @db.Uuid
  // Nullable: SUPER_ADMIN boleh tanpa data karyawan (PLAN §4.1).
  employeeId          String?   @map("employee_id") @db.Uuid
  employee            Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  email               String    @db.VarChar(254)
  // D-048: email login Supabase saat ini bila berbeda dari `email` (alamat turunan NIK, domain .invalid).
  // null = login memakai `email`. `email` tetap alamat kontak akun.
  loginEmail          String?   @map("login_email") @db.VarChar(254)
  role                Role
  isActive            Boolean   @default(true) @map("is_active")
  // PLAN §4.4: tepat satu akun Utama (index unik parsial + CHECK di migrasi).
  isPrimarySuperAdmin Boolean   @default(false) @map("is_primary_super_admin")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  grants          PermissionGrant[] @relation("GrantAccount")
  grantsGiven     PermissionGrant[] @relation("GrantGrantedBy")
  grantsRevoked   PermissionGrant[] @relation("GrantRevokedBy")
  // D-040: perusahaan yang ditugaskan (dipakai untuk HR_ADMIN).
  companies       AccountCompany[]
  dashboardLayout DashboardLayout?

  @@unique([authUserId])
  @@unique([employeeId])
  @@unique([email])
  @@unique([loginEmail])
  @@index([role])
  @@map("accounts")
  @@schema("iam")
}

model PermissionGrant {
  id         String     @id @default(uuid()) @db.Uuid
  accountId  String     @map("account_id") @db.Uuid
  account    Account    @relation("GrantAccount", fields: [accountId], references: [id], onDelete: Restrict)
  permission Permission
  expiresAt  DateTime?  @map("expires_at") @db.Timestamptz(6)
  reason     String?
  grantedBy  String     @map("granted_by") @db.Uuid
  granter    Account    @relation("GrantGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict)
  revokedAt  DateTime?  @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?    @map("revoked_by") @db.Uuid
  revoker    Account?   @relation("GrantRevokedBy", fields: [revokedBy], references: [id], onDelete: Restrict)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([accountId])
  @@index([grantedBy])
  @@index([revokedBy])
  @@map("permission_grants")
  @@schema("iam")
}

// D-040: cakupan perusahaan akun HR_ADMIN (SUPER_ADMIN semua; MANAGER/EMPLOYEE tidak memakai tabel ini).
// FK ke organization.companies diizinkan (modul inti, PLAN §3.2). Diatur SUPER_ADMIN, tercatat di audit.
model AccountCompany {
  accountId  String   @map("account_id") @db.Uuid
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companyId  String   @map("company_id") @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  // Akun SUPER_ADMIN yang menugaskan; null = migrasi/script.
  assignedBy String?  @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([accountId, companyId])
  @@index([companyId])
  @@map("account_companies")
  @@schema("iam")
}

// D-062: susunan widget Dashboard per akun (preferensi tampilan; tanpa data karyawan). Isi `layout`
// divalidasi dashboardLayoutSchema (@hris/shared) saat simpan & baca; versi lama → susunan bawaan.
model DashboardLayout {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  layout    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([accountId])
  @@map("dashboard_layouts")
  @@schema("iam")
}

// D-048: pembatas "lupa password" per masukan (NIK/email di-hash SHA-256, tanpa nilai asli).
model PasswordResetAttempt {
  id        String   @id @default(uuid()) @db.Uuid
  keyHash   String   @map("key_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([keyHash, createdAt])
  @@map("password_reset_attempts")
  @@schema("iam")
}
