// Modul attendance — Time Management (desain docs/features/time-management/design.md, D-067–D-072).
// Tabel modul lain (employee, organization) tidak disentuh: id karyawan/PT/lokasi disimpan tanpa relasi Prisma
// (relasi butuh sisi balik di skema mereka); keberadaannya divalidasi service saat menulis.

// ── Tahap A: kalender libur & pengaturan Time Management ─────────────────────────
// Kalender libur dipakai roster, absensi, & cuti (D-072). NATIONAL = tanggal merah; COLLECTIVE_LEAVE = cuti
// bersama (tidak memotong cuti, kecuali hari kerja roster & tidak masuk → 1 hari cuti). Diatur SUPER_ADMIN.
// Catatan: PLAN menempatkan hari libur di modul organization; dipindah ke attendance (2026-10-12) supaya
// skema organization yang masih dikembangkan tidak disentuh.
enum HolidayKind {
  NATIONAL
  COLLECTIVE_LEAVE

  @@schema("attendance")
}

model Holiday {
  id        String      @id @default(uuid()) @db.Uuid
  date      DateTime    @db.Date
  name      String      @db.VarChar(120)
  kind      HolidayKind
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([date])
  @@map("holidays")
  @@schema("attendance")
}

// Pengaturan Time Management (satu baris per kunci; nilai JSON divalidasi skema per kunci di service).
model TimeSetting {
  key                String   @id @db.VarChar(60)
  value              Json
  updatedByAccountId String?  @map("updated_by_account_id") @db.Uuid
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("time_settings")
  @@schema("attendance")
}

// ── Tahap B: roster tambang (D-069) ─────────────────────────────────────────────
// Id PT / lokasi / karyawan disimpan tanpa relasi Prisma (lihat catatan di atas).

// Shift per PT. Jam dalam menit sejak 00:00 (0–1439); selesai ≤ mulai = lintas tengah malam (tanggal kerja =
// tanggal mulai). Jendela absen & toleransi per shift (D-069).
model Shift {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  code                   String    @db.VarChar(10)
  name                   String    @db.VarChar(80)
  startMinute            Int       @map("start_minute") @db.SmallInt
  endMinute              Int       @map("end_minute") @db.SmallInt
  /// TM-D13: shift mulai setelah tengah malam tanggal roster (shift 3 roster 27 = 28 00:00–08:00).
  startsNextDay          Boolean   @default(false) @map("starts_next_day")
  checkInOpenMin         Int       @default(60) @map("check_in_open_min") @db.SmallInt
  lateToleranceMin       Int       @default(15) @map("late_tolerance_min") @db.SmallInt
  earlyLeaveToleranceMin Int       @default(15) @map("early_leave_tolerance_min") @db.SmallInt
  checkOutCloseMin       Int       @default(30) @map("check_out_close_min") @db.SmallInt
  /// TM-D7: jatah istirahat (menit) & apakah istirahat termasuk jam kerja dibayar (JT: ya).
  breakMin               Int       @default(0) @map("break_min") @db.SmallInt
  breakPaid              Boolean   @default(false) @map("break_paid")
  /// TM-D12: jendela Mulai istirahat (menit dari 00:00 zona shift); null = bebas kapan saja.
  breakStartMinute       Int?      @map("break_start_minute") @db.SmallInt
  breakEndMinute         Int?      @map("break_end_minute") @db.SmallInt
  /// TM-D6: menit terakhir shift yang merupakan lembur rutin (JT: 60) — disetujui lewat approval absen harian.
  regularOvertimeMin     Int       @default(0) @map("regular_overtime_min") @db.SmallInt
  color                  String?   @db.VarChar(9)
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  rosterDays RosterDay[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("shifts")
  @@schema("attendance")
}

// Pola siklus: daftar kode shift atau "OFF" berurutan (mis. D×10 + OFF×4).
model RosterPattern {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String    @db.VarChar(80)
  steps     String[]  @db.VarChar(10)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  crews Crew[]

  @@unique([companyId, name])
  @@map("roster_patterns")
  @@schema("attendance")
}

// Crew: kelompok karyawan satu lokasi kerja dengan pola + tanggal mulai siklus yang sama.
model Crew {
  id             String        @id @default(uuid()) @db.Uuid
  companyId      String        @map("company_id") @db.Uuid
  workLocationId String        @map("work_location_id") @db.Uuid
  name           String        @db.VarChar(80)
  patternId      String        @map("pattern_id") @db.Uuid
  pattern        RosterPattern @relation(fields: [patternId], references: [id], onDelete: Restrict)
  cycleStartDate DateTime      @map("cycle_start_date") @db.Date
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  members CrewMember[]

  @@unique([companyId, name])
  @@index([patternId])
  @@index([workLocationId])
  @@map("crews")
  @@schema("attendance")
}

// Keanggotaan crew berlaku dari/sampai — pindah crew tidak menghapus riwayat.
model CrewMember {
  id         String    @id @default(uuid()) @db.Uuid
  crewId     String    @map("crew_id") @db.Uuid
  crew       Crew      @relation(fields: [crewId], references: [id], onDelete: Cascade)
  employeeId String    @map("employee_id") @db.Uuid
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([crewId])
  @@index([employeeId, startDate])
  @@map("crew_members")
  @@schema("attendance")
}

// TM-D1: pengaturan lokasi absen per karyawan (SA + HR PT). Tidak ada baris = bawaan (lokasi crew → lokasi
// kerja). anywhere = bebas lokasi (PLAN §5.4: tanpa cek geofence, koordinat tetap dicatat); selain itu
// work_location_id = lokasi absen khusus yang mengalahkan lokasi crew/lokasi kerja.
model EmployeeLocationSetting {
  employeeId         String   @id @map("employee_id") @db.Uuid
  workLocationId     String?  @map("work_location_id") @db.Uuid
  anywhere           Boolean  @default(false)
  updatedByAccountId String   @map("updated_by_account_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([workLocationId])
  @@map("employee_location_settings")
  @@schema("attendance")
}

enum RosterSource {
  PATTERN
  MANUAL
  IMPORT
  CHANGE

  @@schema("attendance")
}

// Satu baris per karyawan per tanggal kerja: shift (null = OFF). Hari MANUAL/IMPORT/CHANGE tidak ditimpa pola.
model RosterDay {
  id         String       @id @default(uuid()) @db.Uuid
  employeeId String       @map("employee_id") @db.Uuid
  workDate   DateTime     @map("work_date") @db.Date
  shiftId    String?      @map("shift_id") @db.Uuid
  shift      Shift?       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  crewId     String?      @map("crew_id") @db.Uuid
  source     RosterSource
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@index([shiftId])
  @@map("roster_days")
  @@schema("attendance")
}

enum RosterChangeStatus {
  AWAITING_PEER
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("attendance")
}

// Perubahan satu tanggal, atau tukar shift dengan rekan pada tanggal yang sama (rekan setuju dulu, D-069).
model RosterChangeRequest {
  id                  String             @id @default(uuid()) @db.Uuid
  employeeId          String             @map("employee_id") @db.Uuid
  createdByEmployeeId String             @map("created_by_employee_id") @db.Uuid
  workDate            DateTime           @map("work_date") @db.Date
  fromShiftId         String?            @map("from_shift_id") @db.Uuid
  toShiftId           String?            @map("to_shift_id") @db.Uuid
  peerEmployeeId      String?            @map("peer_employee_id") @db.Uuid
  reason              String             @db.VarChar(500)
  status              RosterChangeStatus
  peerDecidedAt       DateTime?          @map("peer_decided_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId, workDate])
  @@index([peerEmployeeId, status])
  @@map("roster_change_requests")
  @@schema("attendance")
}

// ── Tahap C: absen PWA (D-067, D-070) ────────────────────────────────────────────
/// TM-D13 Fase B: hasil verifikasi atasan atas hari Alpha (tidak absen).
enum AlphaVerification {
  PENDING // menunggu atasan
  CONFIRMED // Alpha dikonfirmasi
  PERMIT // izin → karyawan mengajukan izin (diputus HR)
  SICK // sakit → karyawan mengajukan sakit (diputus HR)
  DUTY // tugas luar / dinas → karyawan mengajukan koreksi absen (diputus HR)

  @@schema("attendance")
}

enum AttendanceDayStatus {
  OPEN // sudah absen masuk, menunggu absen pulang
  PENDING // menunggu persetujuan MANAGER + HR (D-068)
  APPROVED
  REJECTED
  ALPHA // ditetapkan saat tutup periode (D-071)
  LEAVE // cuti/izin/sakit disetujui (Tahap E)

  @@schema("attendance")
}

// Satu hari absen per karyawan per tanggal kerja (shift malam → tanggal mulai). Snapshot shift & PT disimpan
// supaya perubahan master tidak mengubah riwayat. Label penyimpangan (D-070) tidak memblokir.
model AttendanceDay {
  id                    String              @id @default(uuid()) @db.Uuid
  employeeId            String              @map("employee_id") @db.Uuid
  companyId             String              @map("company_id") @db.Uuid
  managerEmployeeId     String?             @map("manager_employee_id") @db.Uuid
  workDate              DateTime            @map("work_date") @db.Date
  shiftId               String?             @map("shift_id") @db.Uuid
  shiftCode             String?             @map("shift_code") @db.VarChar(10)
  scheduledStart        DateTime?           @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd          DateTime?           @map("scheduled_end") @db.Timestamptz(6)
  checkOutDeadline      DateTime?           @map("check_out_deadline") @db.Timestamptz(6)
  workLocationId        String?             @map("work_location_id") @db.Uuid
  status                AttendanceDayStatus
  labels                String[]            @db.VarChar(20)
  /// TM-D13 Fase B: verifikasi atasan atas Alpha tanpa absen (null = bukan Alpha harian / sebelum aturan).
  alphaVerification     AlphaVerification?  @map("alpha_verification")
  alphaVerifiedBy       String?             @map("alpha_verified_by") @db.Uuid
  alphaVerifiedAt       DateTime?           @map("alpha_verified_at") @db.Timestamptz(6)
  alphaVerificationNote String?             @map("alpha_verification_note") @db.VarChar(300)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  punches AttendancePunch[]

  @@unique([employeeId, workDate])
  @@index([companyId, workDate])
  @@index([status, checkOutDeadline])
  @@index([managerEmployeeId, workDate])
  @@index([alphaVerification, companyId])
  @@map("attendance_days")
  @@schema("attendance")
}

enum PunchKind {
  IN
  OUT
  // TM-D7: absen istirahat (sekali per hari; tanpa approval sendiri, dilihat pemutus di hari absen).
  BREAK_START
  BREAK_END

  @@schema("attendance")
}

// Absen masuk/pulang: waktu SERVER (D-013), GPS + akurasi, jarak ke geofence, selfie (retensi 12 bulan).
/// D-073: tiap absen (masuk/pulang) disetujui sendiri-sendiri.
enum PunchStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("attendance")
}

/// DEVICE = absen dari HP (selfie + GPS); MANUAL = dimasukkan/diperbaiki HR/SA (autentikasi manual).
enum PunchSource {
  DEVICE
  MANUAL

  @@schema("attendance")
}

enum PunchChannel {
  APP
  PWA

  @@schema("attendance")
}

model AttendancePunch {
  id                String        @id @default(uuid()) @db.Uuid
  dayId             String        @map("day_id") @db.Uuid
  day               AttendanceDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  kind              PunchKind
  at                DateTime      @db.Timestamptz(6)
  latitude          Decimal?      @db.Decimal(9, 6)
  longitude         Decimal?      @db.Decimal(9, 6)
  accuracyM         Int?          @map("accuracy_m")
  /// Ketinggian (m dpl) dari GPS HP bila tersedia.
  altitudeM         Int?          @map("altitude_m")
  distanceM         Int?          @map("distance_m")
  workLocationId    String?       @map("work_location_id") @db.Uuid
  insideGeofence    Boolean       @map("inside_geofence")
  labels            String[]      @db.VarChar(20)
  reason            String?       @db.VarChar(500)
  selfiePath        String?       @map("selfie_path") @db.VarChar(300)
  selfiePurgedAt    DateTime?     @map("selfie_purged_at") @db.Timestamptz(6)
  userAgent         String?       @map("user_agent") @db.VarChar(300)
  status            PunchStatus   @default(PENDING)
  source            PunchSource   @default(DEVICE)
  /// MOB-D3: kanal absen (APP = app Android, PWA = web /absen) + versi app.
  channel           PunchChannel  @default(PWA)
  appVersion        String?       @map("app_version") @db.VarChar(40)
  /// MOB-D7: kunci idempotensi dari klien; retry dengan kunci sama mengembalikan punch yang sudah ada.
  idempotencyKey    String?       @unique @map("idempotency_key") @db.VarChar(64)
  manualByAccountId String?       @map("manual_by_account_id") @db.Uuid
  decidedAt         DateTime?     @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([dayId, kind])
  @@index([at])
  @@index([status])
  @@map("attendance_punches")
  @@schema("attendance")
}

// ── Tahap F — tutup periode, surat pernyataan, koreksi (D-071) ──────────────────

enum AttendancePeriodStatus {
  OPEN
  CLOSED

  @@schema("attendance")
}

/// Periode absensi per PT per bulan. CLOSED = hari tanpa persetujuan/absen sudah menjadi ALPHA & terkunci.
model AttendancePeriod {
  id                String                 @id @default(uuid()) @db.Uuid
  companyId         String                 @map("company_id") @db.Uuid
  month             String                 @db.VarChar(7)
  status            AttendancePeriodStatus @default(OPEN)
  closedAt          DateTime?              @map("closed_at") @db.Timestamptz(6)
  closedByAccountId String?                @map("closed_by_account_id") @db.Uuid
  summary           Json?
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([companyId, month])
  @@map("attendance_periods")
  @@schema("attendance")
}

/// Surat Pernyataan Absensi untuk satu hari ALPHA (catatan kepatuhan; tidak mengubah status ALPHA).
model AttendanceStatement {
  id                String   @id @default(uuid()) @db.Uuid
  dayId             String   @unique @map("day_id") @db.Uuid
  employeeId        String   @map("employee_id") @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  managerEmployeeId String?  @map("manager_employee_id") @db.Uuid
  workDate          DateTime @map("work_date") @db.Date
  reason            String   @db.VarChar(1000)
  attachmentPath    String?  @map("attachment_path") @db.VarChar(300)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([companyId, workDate])
  @@index([employeeId])
  @@map("attendance_statements")
  @@schema("attendance")
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("attendance")
}

/// Koreksi absensi (lupa absen, absen ditolak): approval paralel; disetujui → hari absen APPROVED (label CORRECTED).
model AttendanceCorrection {
  id                String                     @id @default(uuid()) @db.Uuid
  employeeId        String                     @map("employee_id") @db.Uuid
  companyId         String                     @map("company_id") @db.Uuid
  managerEmployeeId String?                    @map("manager_employee_id") @db.Uuid
  workDate          DateTime                   @map("work_date") @db.Date
  checkInAt         DateTime?                  @map("check_in_at") @db.Timestamptz(6)
  checkOutAt        DateTime?                  @map("check_out_at") @db.Timestamptz(6)
  reason            String                     @db.VarChar(500)
  status            AttendanceCorrectionStatus @default(PENDING)
  decidedAt         DateTime?                  @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId, workDate])
  @@index([companyId, status])
  @@map("attendance_corrections")
  @@schema("attendance")
}

// ── TM-D6: lembur & upah grade ──────────────────────────────────────────────────

/// Upah per grade (pokok + tunjangan tetap) untuk estimasi rupiah lembur, kompensasi & labor cost (bukan
/// gaji per orang; payroll Fase 8 menggantinya). Ditulis SA; dibaca SA + HR ber-grant labor.cost.read.
/// grade_id = organization.grades.id tanpa relasi Prisma (skema organization tidak disentuh).
model GradeWage {
  gradeId            String   @id @map("grade_id") @db.Uuid
  basePay            Decimal  @map("base_pay") @db.Decimal(14, 2)
  fixedAllowance     Decimal  @default(0) @map("fixed_allowance") @db.Decimal(14, 2)
  updatedByAccountId String   @map("updated_by_account_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("grade_wages")
  @@schema("attendance")
}

enum OvertimeDayType {
  WORKDAY // hari kerja roster
  OFF_DAY // hari OFF rotasi / tanpa roster — tarif lembur biasa (TM-D6, risiko diterima)
  HOLIDAY // tanggal merah nasional — seluruh jam tarif libur

  @@schema("attendance")
}

enum OvertimeFormula {
  SIX_DAY
  FIVE_DAY

  @@schema("attendance")
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("attendance")
}

/// TM-D17: perintah lembur (SPL) dari Atasan langsung / HR PT, dibuat sebelum dijalani dan langsung berlaku.
/// Satu per karyawan per tanggal kerja. Hari kerja: `startsAt` = mulai lebih awal (≤ jam masuk), `endsAt` =
/// selesai lebih lambat (≥ jam pulang), salah satu boleh null. Hari OFF: keduanya terisi. Lembur hanya diakui
/// di dalam rentang ini; batas Clock Out ikut mundur. Dibatalkan = baris dihapus (jejak di audit).
model OvertimeOrder {
  id                 String    @id @default(uuid()) @db.Uuid
  employeeId         String    @map("employee_id") @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  workDate           DateTime  @map("work_date") @db.Date
  startsAt           DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime? @map("ends_at") @db.Timestamptz(6)
  reason             String    @db.VarChar(300)
  createdByAccountId String    @map("created_by_account_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, workDate])
  @@index([companyId, workDate])
  @@map("overtime_orders")
  @@schema("attendance")
}

/// Usulan lembur otomatis per hari absen (TM-D6): kelebihan jam di luar jadwal (termasuk datang awal)
/// setelah dikurangi utang menit; diputuskan Atasan + HR paralel. Lembur rutin shift tidak di sini (ikut
/// approval absen harian) tetapi dicatat sebagai snapshot supaya urutan pengali benar.
model OvertimeRequest {
  id                String          @id @default(uuid()) @db.Uuid
  dayId             String          @unique @map("day_id") @db.Uuid
  employeeId        String          @map("employee_id") @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  managerEmployeeId String?         @map("manager_employee_id") @db.Uuid
  workDate          DateTime        @map("work_date") @db.Date
  dayType           OvertimeDayType @map("day_type")
  formula           OvertimeFormula
  /// Menit di luar jadwal sebelum pengurangan (datang awal + pulang lewat; hari OFF/libur = seluruh jam kerja).
  rawMin            Int             @map("raw_min")
  earlyMin          Int             @default(0) @map("early_min")
  /// Utang menit hari itu (telat + istirahat lebih).
  debtMin           Int             @map("debt_min")
  /// Lembur rutin riil hari itu (sudah termasuk jadwal shift).
  regularMin        Int             @map("regular_min")
  /// Menit lembur tambahan yang diusulkan (setelah aturan ≥ 60 menit & pembulatan ke atas per 30 menit).
  proposedMin       Int             @map("proposed_min")
  /// Jam setara bagian tambahan (pengali dilanjutkan setelah lembur rutin).
  equivalentHours   Decimal         @map("equivalent_hours") @db.Decimal(6, 2)
  /// OVER_DAY_LIMIT / OVER_WEEK_LIMIT (PP 35/2021) → alasan wajib dari pemutus.
  flags             String[]        @db.VarChar(20)
  status            OvertimeStatus  @default(PENDING)
  decidedAt         DateTime?       @map("decided_at") @db.Timestamptz(6)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId, workDate])
  @@index([companyId, workDate])
  @@index([status])
  @@map("overtime_requests")
  @@schema("attendance")
}
