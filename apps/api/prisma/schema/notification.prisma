// Modul notification (PLAN §5.6): in-app + email. Isi TIDAK PERNAH memuat data sensitif.
// Modul non-inti: penerima disimpan sebagai UUID akun tanpa FK (PLAN §3.2.3).

enum EmailOutboxStatus {
  PENDING
  SENT
  FAILED

  @@schema("notification")
}

model Notification {
  id                 String    @id @default(uuid()) @db.Uuid
  recipientAccountId String    @map("recipient_account_id") @db.Uuid
  type               String    @db.VarChar(50)
  title              String    @db.VarChar(200)
  body               String?
  link               String?   @db.VarChar(500)
  // Mencegah notifikasi ganda dari cron (mis. `grant-expiring:<grantId>`), unik per penerima.
  dedupeKey          String?   @map("dedupe_key") @db.VarChar(200)
  // MOB-D6: target terstruktur untuk app mobile (mis. LEAVE_REQUEST + id), di samping `link` web.
  targetType         String?   @map("target_type") @db.VarChar(50)
  targetId           String?   @map("target_id") @db.VarChar(64)
  readAt             DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([recipientAccountId, dedupeKey])
  @@index([recipientAccountId, readAt])
  @@index([createdAt])
  @@map("notifications")
  @@schema("notification")
}

// Email yang gagal dikirim, dicoba ulang oleh cron `email-retry` (CODEMAP §7).
model EmailOutbox {
  id            String            @id @default(uuid()) @db.Uuid
  toEmail       String            @map("to_email") @db.VarChar(254)
  subject       String            @db.VarChar(200)
  textBody      String            @map("text_body")
  status        EmailOutboxStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?           @map("last_error") @db.VarChar(500)
  nextAttemptAt DateTime?         @map("next_attempt_at") @db.Timestamptz(6)
  sentAt        DateTime?         @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
  @@schema("notification")
}

enum PushPlatform {
  ANDROID

  @@schema("notification")
}

// MOB-D6: token FCM perangkat app mobile. Satu token = satu perangkat; pindah ke akun yang terakhir
// login di perangkat itu. Token ditolak FCM (tidak terdaftar lagi) dihapus saat pengiriman.
model PushDevice {
  id         String       @id @default(uuid()) @db.Uuid
  accountId  String       @map("account_id") @db.Uuid
  token      String       @unique @db.VarChar(512)
  platform   PushPlatform
  appVersion String?      @map("app_version") @db.VarChar(40)
  lastSeenAt DateTime     @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([accountId])
  @@map("push_devices")
  @@schema("notification")
}
