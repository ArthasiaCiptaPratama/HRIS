// Modul leave — cuti tahunan, izin, sakit (docs/features/time-management/design.md §7, D-072).
// Tanpa relasi Prisma ke employee/organization (skema tim yang masih dikembangkan tidak disentuh);
// id karyawan/PT disimpan sebagai uuid biasa.

enum LeaveCategory {
  ANNUAL // memotong saldo cuti tahunan
  PERMIT // izin (menikah, duka, …) — kuota per kejadian
  SICK // sakit — surat dokter di atas N hari

  @@schema("leave")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@schema("leave")
}

/// Jenis baris buku besar saldo cuti tahunan (§7.2). `days` bertanda: + menambah, − mengurangi.
enum LeaveLedgerKind {
  GRANT // jatah 1 Januari (penuh / prorata)
  HOLD // ditahan saat pengajuan (−)
  RELEASE // tahanan dilepas: ditolak/dibatalkan, atau dikonversi saat disetujui (+)
  USE // terpakai saat disetujui (−)
  COLLECTIVE // cuti bersama pada hari kerja roster tanpa absen (−1)
  EXPIRE // sisa tahun lalu hangus 31 Maret (−)
  SETTLE // pelunasan hutang akhir Januari (tahun baru −, tahun lama +)
  ADJUST // penyesuaian / saldo awal import (±)

  @@schema("leave")
}

model LeaveType {
  id                        String        @id @default(uuid()) @db.Uuid
  code                      String        @unique @db.VarChar(20)
  name                      String        @db.VarChar(80)
  category                  LeaveCategory
  /// Kuota hari per kejadian (izin); null = tanpa batas per pengajuan.
  maxDaysPerRequest         Int?          @map("max_days_per_request") @db.SmallInt
  /// Dokumen wajib bila hari > nilai ini (0 = selalu wajib); null = tidak wajib.
  documentRequiredAfterDays Int?          @map("document_required_after_days") @db.SmallInt
  /// Keterangan untuk karyawan (kapan izin ini dipakai); diatur SA di Master Cuti.
  description               String?       @db.VarChar(300)
  /// Berkas yang diperlukan (mis. "Surat keterangan dokter"); wajib/opsional tetap dari documentRequiredAfterDays.
  documentLabel             String?       @map("document_label") @db.VarChar(120)
  isActive                  Boolean       @default(true) @map("is_active")
  sortOrder                 Int           @default(0) @map("sort_order") @db.SmallInt
  createdAt                 DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  requests LeaveRequest[]

  @@map("leave_types")
  @@schema("leave")
}

/// Master Cuti per tahun: kuota penuh & status. Jatah dibagikan cron 1 Januari (grantedAt).
model LeaveYear {
  id        String    @id @default(uuid()) @db.Uuid
  year      Int       @unique @db.SmallInt
  quota     Int       @default(12) @db.SmallInt
  isActive  Boolean   @default(true) @map("is_active")
  grantedAt DateTime? @map("granted_at") @db.Timestamptz(6)
  settledAt DateTime? @map("settled_at") @db.Timestamptz(6)
  expiredAt DateTime? @map("expired_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("leave_years")
  @@schema("leave")
}

/// Buku besar saldo cuti tahunan per karyawan per tahun jatah. Saldo = jumlah `days` pada tahun itu.
model LeaveLedger {
  id               String          @id @default(uuid()) @db.Uuid
  employeeId       String          @map("employee_id") @db.Uuid
  companyId        String          @map("company_id") @db.Uuid
  year             Int             @db.SmallInt
  kind             LeaveLedgerKind
  days             Int             @db.SmallInt
  requestId        String?         @map("request_id") @db.Uuid
  /// Tanggal kerja terkait (cuti bersama, hari cuti) bila ada.
  workDate         DateTime?       @map("work_date") @db.Date
  note             String?         @db.VarChar(300)
  createdByAccount String?         @map("created_by_account_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([employeeId, year])
  @@index([companyId, year])
  @@index([requestId])
  @@map("leave_ledger")
  @@schema("leave")
}

model LeaveRequest {
  id                  String             @id @default(uuid()) @db.Uuid
  employeeId          String             @map("employee_id") @db.Uuid
  companyId           String             @map("company_id") @db.Uuid
  managerEmployeeId   String?            @map("manager_employee_id") @db.Uuid
  leaveTypeId         String             @map("leave_type_id") @db.Uuid
  category            LeaveCategory
  startDate           DateTime           @map("start_date") @db.Date
  endDate             DateTime           @map("end_date") @db.Date
  /// Hari kerja roster yang dihitung (§7.3).
  workDates           DateTime[]         @map("work_dates") @db.Date
  days                Int                @db.SmallInt
  reason              String             @db.VarChar(500)
  attachmentPath      String?            @map("attachment_path") @db.VarChar(300)
  status              LeaveRequestStatus @default(PENDING)
  createdByEmployeeId String             @map("created_by_employee_id") @db.Uuid
  decidedAt           DateTime?          @map("decided_at") @db.Timestamptz(6)
  /// TM-D9: pengajuan ulang dari pengajuan yang ditolak (≤ 6 bulan sejak penolakan pertama).
  resubmittedFromId   String?            @map("resubmitted_from_id") @db.Uuid
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  type LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([employeeId, startDate])
  @@index([resubmittedFromId])
  @@index([companyId, status])
  @@map("leave_requests")
  @@schema("leave")
}

enum LeaveExitStatus {
  OPEN // menunggu diproses di payroll akhir
  PAID // sudah diproses
  CANCELLED // karyawan diaktifkan lagi

  @@schema("leave")
}

/// TM-D9: hak cuti saat karyawan keluar (alasan apa pun) — sisa cuti dibayar uang penggantian hak, hutang
/// cuti dicatat untuk dipotong payroll akhir. Snapshot upah grade & pembagi saat dihitung (payroll Fase 8
/// belum ada; ini catatan untuk HR). Dibuat otomatis cron leave-daily / tombol HR.
model LeaveExitSettlement {
  id                 String          @id @default(uuid()) @db.Uuid
  employeeId         String          @map("employee_id") @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  exitDate           DateTime        @map("exit_date") @db.Date
  year               Int             @db.SmallInt
  /// Sisa cuti tahun keluar (≥ 0) & hutang (≥ 0, tahun keluar + sisa hutang tahun sebelumnya).
  remainingDays      Int             @map("remaining_days") @db.SmallInt
  debtDays           Int             @map("debt_days") @db.SmallInt
  /// Pengajuan cuti yang masih menunggu saat dihitung (tidak dihitung sebagai pemakaian).
  pendingDays        Int             @default(0) @map("pending_days") @db.SmallInt
  formula            String          @db.VarChar(10)
  divisor            Int             @db.SmallInt
  gradeId            String?         @map("grade_id") @db.Uuid
  monthlyWage        Decimal?        @map("monthly_wage") @db.Decimal(14, 2)
  payAmount          Decimal?        @map("pay_amount") @db.Decimal(14, 2)
  debtAmount         Decimal?        @map("debt_amount") @db.Decimal(14, 2)
  status             LeaveExitStatus @default(OPEN)
  note               String?         @db.VarChar(300)
  decidedByAccountId String?         @map("decided_by_account_id") @db.Uuid
  decidedAt          DateTime?       @map("decided_at") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@index([companyId, status])
  @@map("leave_exit_settlements")
  @@schema("leave")
}
