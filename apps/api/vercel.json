{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "hono",
  "bunVersion": "1.x",
  "regions": ["sin1"],
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "bun run db:generate && bun build src/index.ts --target=bun --outdir=dist --external hono",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/grant-expiry",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/email-retry",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/onboarding-invitations",
      "schedule": "0 3 * * *"
    }
  ]
}
