{
  "name": "@hris/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun --env-file=../../.env test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "bun --env-file=../../.env scripts/guard-local-db.ts && prisma migrate reset --force && prisma db seed",
    "db:seed": "bun --env-file=../../.env scripts/guard-local-db.ts && prisma db seed",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema --exit-code",
    "db:use": "bun --env-file=../../.env scripts/use-db.ts",
    "db:which": "bun --env-file=../../.env scripts/use-db.ts",
    "bootstrap:super-admin": "bun --env-file=../../.env scripts/bootstrap-super-admin.ts",
    "recover:primary-admin": "bun --env-file=../../.env scripts/recover-primary-admin.ts",
    "dev:account": "bun --env-file=../../.env scripts/create-dev-account.ts",
    "demo:dashboard": "bun --env-file=../../.env scripts/guard-local-db.ts && bun --env-file=../../.env scripts/seed-dashboard-demo.ts",
    "storage:setup": "bun --env-file=../../.env scripts/setup-storage.ts",
    "auth:migrate-login-nik": "bun --env-file=../../.env scripts/migrate-login-nik.ts",
    "org:import-local": "bun --env-file=../../.env scripts/import-org-local.ts"
  },
  "dependencies": {
    "@hono/swagger-ui": "0.6.1",
    "@hono/zod-openapi": "1.6.3",
    "@hris/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "2.117.2",
    "hono": "4.13.9",
    "jimp": "1.6.1",
    "jose": "6.2.12",
    "nodemailer": "10.0.11",
    "pdf-lib": "1.17.1",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.4",
    "fflate": "0.8.3",
    "prisma": "7.10.0"
  }
}
