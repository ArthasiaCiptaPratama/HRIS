# Salin ke .env (tidak di-commit). Daftar & penjelasan: docs/CODEMAP.md §8.
# Nilai rahasia TIDAK PERNAH diisi di file ini.

# ---------- api ----------
# DATABASE_URL & DIRECT_URL = profil DB AKTIF. Ditulis ulang oleh `bun run db:use local|supabase`
# dari profil LOCAL_*/SUPABASE_* di bawah. Lihat `bun run db:which` untuk cek target aktif.
# Lokal: PostgreSQL Docker (bun run db:up). Staging/produksi: transaction pooler Supabase (port 6543).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hris
# Lokal: sama dengan DATABASE_URL. Staging/produksi: koneksi direct/session (port 5432) untuk prisma migrate.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hris

# ---------- Profil DB untuk `bun run db:use` (tukar DATABASE_URL/DIRECT_URL/STORAGE_PATH_PREFIX) ----------
# Isi kedua profil sekali, lalu tukar kapan saja: `bun run db:use local` / `bun run db:use supabase`.
# Panduan "kapan pakai apa": skill .claude/skills/hris-db-switch.
# Catatan: SUPABASE_URL (Auth/JWKS, di bawah) BERBEDA dari SUPABASE_DATABASE_URL (koneksi Postgres) di sini.
# Profil "local": PostgreSQL Docker.
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hris
LOCAL_DIRECT_URL=postgresql://postgres:postgres@localhost:5432/hris
LOCAL_STORAGE_PATH_PREFIX=dev/nama-anda/
# Profil "supabase": pooler Supabase (RAHASIA — password di dalam URL; jangan commit).
# Kolaborator: isi otomatis dengan `bun run env:pull` (passphrase dari pemilik projek, lewat chat pribadi).
# DATABASE_URL = transaction pooler (port 6543). DIRECT_URL = session pooler (port 5432) untuk prisma migrate.
SUPABASE_DATABASE_URL=
SUPABASE_DIRECT_URL=
SUPABASE_STORAGE_PATH_PREFIX=

# ---------- OPSIONAL: mode terpisah penuh (Auth & Storage juga lokal; skill hris-db-switch) ----------
# Biarkan kosong = perilaku lama (Auth & Storage selalu Supabase staging).
# Diisi otomatis oleh `bun run auth:local:up` (Supabase lokal di Docker). Lalu `db:use local` ikut menukar
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY dan mencadangkan
# nilai staging ke STAGING_<kunci> (dipulihkan oleh `db:use supabase`).
LOCAL_SUPABASE_URL=
LOCAL_SUPABASE_SERVICE_ROLE_KEY=
LOCAL_VITE_SUPABASE_URL=
LOCAL_VITE_SUPABASE_ANON_KEY=

PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
APP_URL=http://localhost:5173

# Supabase project STAGING saat develop lokal (D-023, D-029). WAJIB kecuali NODE_ENV=test (verifikasi JWT via JWKS).
SUPABASE_URL=https://iwgzuwcxsxnbjibhbqgh.supabase.co
# RAHASIA: hanya di server/script, tidak pernah ke frontend. Dipakai bootstrap:super-admin (Admin API).
# Ambil dari Dashboard → Project Settings → API Keys (service_role / secret key).
SUPABASE_SERVICE_ROLE_KEY=

# RAHASIA: dipakai endpoint /api/cron/*.
CRON_SECRET=

# SMTP Google Workspace (D-025). Kosong di lokal -> email aplikasi hanya dicatat ke log.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
# RAHASIA: App Password akun pengirim.
SMTP_PASS=
EMAIL_FROM=
# D-045: batas undangan aktivasi per jam (default 25, di bawah limit email Supabase Auth).
ONBOARDING_INVITES_PER_HOUR=
# D-048: domain alamat login NIK, PER LINGKUNGAN (Auth staging dipakai bersama). Lokal: dev-<nama>.login.akselerasi.invalid ;
# staging: stg.login.akselerasi.invalid. Kosong = login NIK nonaktif. Web memakai VITE_LOGIN_EMAIL_DOMAIN dengan nilai SAMA.
LOGIN_EMAIL_DOMAIN=

# Lokal: dev/<nama-developer>/ ; staging/produksi: kosong
STORAGE_PATH_PREFIX=
# D-060: kunci service account Google (isi file .json dalam SATU baris, diapit kutip tunggal) untuk
# lampiran Google Drive di Import. Bagikan folder unggahan Form ke email service account (Viewer).
# Kosong = lampiran tercatat di antrean tetapi belum bisa diproses. RAHASIA: jangan di-commit.
GOOGLE_SERVICE_ACCOUNT_JSON=

# MOB-D6: kunci service account Firebase (isi file .json dalam SATU baris, diapit kutip tunggal) untuk
# push notification app mobile. Kosong = tanpa push (in-app & email tetap). RAHASIA: jangan di-commit.
FCM_SERVICE_ACCOUNT_JSON=
# MOB-D7: versi minimum app mobile (mis. 1.0.0) + tautan unduh APK terbaru. Kosong = semua versi diterima.
MOBILE_MIN_VERSION=
MOBILE_APK_URL=

# Seed dummy (bun run db:seed): email developer untuk plus-addressing, mis. nama@gmail.com
# -> nama+dev-budi-0001@gmail.com. Kosong -> work_email karyawan dummy dibiarkan kosong.
SEED_EMAIL_BASE=

# ---------- web (Vite; hanya variabel VITE_* yang sampai ke browser) ----------
# VITE_SUPABASE_URL & VITE_SUPABASE_ANON_KEY WAJIB (login Supabase). ANON_KEY = publishable key (publik, bukan rahasia).
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SUPABASE_URL=https://iwgzuwcxsxnbjibhbqgh.supabase.co
VITE_SUPABASE_ANON_KEY=
# D-048: sama dengan LOGIN_EMAIL_DOMAIN (kosong = kolom login hanya menerima email).
VITE_LOGIN_EMAIL_DOMAIN=
