// ERD HRIS — format DBML untuk https://dbdiagram.io
// Cerminan apps/api/prisma/schema/{organization,employee}.prisma (D-026), disetujui pemilik projek 2026-09-28.
// Wajib diperbarui bersama setiap migrasi yang mengubah tabel di sini (CODEMAP §10).
// Aturan hapus (tidak tergambar di DBML): FK ke master organization = RESTRICT; tabel anak employee = CASCADE.
// Nama enum di Postgres PascalCase ("Gender", "MaritalStatus", ...); di sini snake_case agar mudah dibaca.

Project HRIS_Arthasia {
  database_type: 'PostgreSQL'
  Note: 'Skema ERD employee management (D-026). Satu skema Postgres per modul.'
}

//// ---------- Skema: organization ----------

Table organization.companies {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(10) [not null, unique, note: 'Kode singkat, mis. ACP, PNR']
  name varchar(150) [not null, unique]
  npwp_number varchar(20)
  address text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
  deleted_at timestamptz
  Note: 'D-039: perusahaan dalam grup (multi-entitas). ACP dibuat migrasi; master data lain berlaku untuk seluruh grup'
}

Table organization.departments {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  parent_id uuid [ref: > organization.departments.id, note: 'Hierarki departemen (opsional)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  indexes {
    parent_id
  }
}

Table organization.positions {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null]
  department_id uuid [not null, ref: > organization.departments.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  indexes {
    (department_id, name) [unique]
    department_id
  }
}

Enum organization.employment_category {
  PERMANENT
  PKWT
  INTERNSHIP
  DAILY_WORKER
  OUTSOURCING
  PROBATION
  VENDOR
}

Table organization.employment_statuses {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(50) [not null, unique, note: 'Karyawan Tetap, Karyawan Percobaan, PKWT, Pekerja Harian, Magang, Outsourcing, Vendor (D-038)']
  category organization.employment_category [unique, note: 'D-035/D-038: kategori navigasi Data Karyawan Aktif (grup Internal / Magang / Eksternal); null = tanpa kategori']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table organization.grades {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(50) [not null, unique]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

Table organization.work_locations {
  id uuid [pk, default: `gen_random_uuid()`]
  name varchar(100) [not null, unique]
  city varchar(100)
  address text
  latitude decimal(9,6) [note: 'Geofence, wajib mulai Fase 5']
  longitude decimal(9,6)
  radius_m int
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
  deleted_at timestamptz
}

//// ---------- Skema: employee ----------

Enum employee.gender {
  MALE
  FEMALE
}

Enum employee.marital_status {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

Enum employee.religion {
  ISLAM
  PROTESTANT
  CATHOLIC
  HINDU
  BUDDHIST
  CONFUCIAN
  OTHER
}

Enum employee.family_relationship {
  SPOUSE
  CHILD
  FATHER
  MOTHER
  SIBLING
  OTHER
}

Enum employee.ptkp_status {
  TK0
  TK1
  TK2
  TK3
  K0
  K1
  K2
  K3
}

Enum employee.education_level {
  SD
  SMP
  SMA
  D1
  D2
  D3
  D4
  S1
  S2
  S3
  OTHER
}

Enum employee.import_mode {
  CREATE_ONLY
  UPSERT
}

Enum employee.import_issue_severity {
  ERROR
  WARNING
}

// D-060: status lampiran Google Drive dari Import.
Enum employee.import_attachment_status {
  PENDING
  PROCESSING
  DONE
  SKIPPED
  FAILED
}

Table employee.employees {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_number varchar(30) [unique, note: 'ERD nik = Nomor Induk Karyawan; D-063: boleh kosong (NIP belum diketahui)']
  full_name varchar(150) [not null]
  work_email varchar(254) [unique]
  phone_number varchar(30)
  emergency_phone varchar(30)
  emergency_contact_name varchar(150) [note: 'D-041']
  emergency_contact_relationship varchar(50) [note: 'D-041']
  gender employee.gender
  join_date date [not null]
  end_date date
  employment_status_id uuid [not null, ref: > organization.employment_statuses.id]
  company_id uuid [not null, ref: > organization.companies.id, note: 'D-039: perusahaan tempat terdaftar']
  position_id uuid [not null, ref: > organization.positions.id]
  work_location_id uuid [ref: > organization.work_locations.id]
  grade_id uuid [ref: > organization.grades.id]
  manager_id uuid [ref: > employee.employees.id, note: 'Atasan langsung (PLAN D-009)']
  is_active boolean [not null, default: true]
  exit_reason employee.employee_exit_reason [note: 'D-035: hanya terisi saat nonaktif (CHECK)']
  photo_path varchar(255) [note: 'D-037: path objek di bucket private employee-photos']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    position_id
    (company_id, is_active)
    (employment_status_id, is_active)
    work_location_id
    grade_id
    manager_id
    (is_active, full_name)
  }
}

Enum employee.employee_exit_reason {
  RESIGNATION
  TERMINATION
  CONTRACT_ENDED
  RETIREMENT
  DECEASED
  OTHER
}

Enum employee.employment_change_type {
  HIRED
  STATUS_CHANGED
  POSITION_CHANGED
  DEACTIVATED
  REACTIVATED
  COMPANY_CHANGED
}

Table employee.employment_histories {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null, ref: > employee.employees.id, note: 'ON DELETE CASCADE']
  change_type employee.employment_change_type [not null]
  effective_date date [not null]
  from_status_id uuid [ref: > organization.employment_statuses.id]
  to_status_id uuid [ref: > organization.employment_statuses.id]
  from_position_id uuid [ref: > organization.positions.id]
  to_position_id uuid [ref: > organization.positions.id]
  from_company_id uuid [ref: > organization.companies.id]
  to_company_id uuid [ref: > organization.companies.id]
  exit_reason employee.employee_exit_reason
  note varchar(500)
  changed_by uuid [note: 'iam.accounts.id tanpa FK (iam bukan modul inti)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (employee_id, effective_date)
    from_status_id
    to_status_id
    from_position_id
    to_position_id
    from_company_id
    to_company_id
  }
  Note: 'D-035: riwayat kepegawaian; dasar menu arsip Riwayat Jabatan'
}

Table employee.employee_personal {
  employee_id uuid [pk, ref: - employee.employees.id, note: 'SENSITIF, 1:1, cascade']
  ktp_number varchar(16) [unique, note: 'NIK KTP']
  npwp_number varchar(20)
  kk_number varchar(16)
  birth_place varchar(100)
  birth_date date
  ktp_address text
  domicile_address text
  marital_status employee.marital_status
  religion employee.religion
  bpjs_employment_number varchar(20) [note: 'D-041']
  bpjs_health_number varchar(20) [note: 'D-041']
  ptkp_status employee.ptkp_status [note: 'D-041']
  origin_city varchar(100) [note: 'D-041']
  nickname varchar(50) [note: 'D-059']
  nationality varchar(50) [note: 'D-059']
  ethnicity varchar(50) [note: 'D-059']
  blood_type varchar(3) [note: 'D-059: A/B/AB/O ± rhesus (CHECK)']
  driving_license_types "employee.DrivingLicenseType[]" [note: 'D-059: jenis SIM (jamak)']
  driving_license_number varchar(30) [note: 'D-059: nomor SIM pertama']
  driving_license_numbers jsonb [note: 'D-059: nomor per jenis SIM']
  emergency_contact_address text [note: 'D-059']
  domicile_village varchar(100) [note: 'D-061: rincian alamat (teks isian Form)']
  domicile_district varchar(100) [note: 'D-061']
  domicile_city varchar(100) [note: 'D-061']
  domicile_province varchar(100) [note: 'D-061']
  ktp_village varchar(100) [note: 'D-061']
  ktp_district varchar(100) [note: 'D-061']
  ktp_city varchar(100) [note: 'D-061']
  ktp_province varchar(100) [note: 'D-061']
  emergency_contact2_name varchar(150) [note: 'D-061: kontak darurat ke-2']
  emergency_contact2_relationship varchar(50) [note: 'D-061']
  emergency_contact2_phone varchar(30) [note: 'D-061']
  emergency_contact2_address text [note: 'D-061']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
}

Table employee.employee_bank_accounts {
  employee_id uuid [pk, ref: - employee.employees.id, note: 'SENSITIF, 1:1, cascade']
  bank_name varchar(100) [not null]
  account_number varchar(30) [not null]
  account_holder varchar(150)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
}

Table employee.family_members {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null, ref: > employee.employees.id]
  name varchar(150) [not null]
  relationship employee.family_relationship [not null]
  address text
  birth_date date [note: 'Pengganti age dari ERD']
  phone_number varchar(30)
  gender employee.gender [note: 'D-059']
  birth_place varchar(100) [note: 'D-059']
  education varchar(50) [note: 'D-059']
  occupation varchar(100) [note: 'D-059']
  age_at_entry smallint [note: 'D-059: usia saat didata (CHECK 0–130)']
  work_address text [note: 'D-059']
  relation_detail varchar(30) [note: 'D-061: Kakak/Adik']
  is_deceased boolean [not null, default: false, note: 'D-064: almarhum (Form: usia/pekerjaan)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    employee_id
  }
}

Table employee.educations {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null, ref: > employee.employees.id]
  school_name varchar(150) [not null]
  major varchar(100)
  graduation_year smallint
  level employee.education_level [note: 'D-041: jenjang']
  entry_year smallint [note: 'D-059 (CHECK ≤ graduation_year)']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    employee_id
  }
}

Table employee.trainings {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null, ref: > employee.employees.id]
  training_field varchar(150) [not null]
  organizer varchar(150)
  duration varchar(50)
  training_year smallint
  certificate_number varchar(60) [note: 'D-059']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    employee_id
  }
}

// D-055 (Arsip 1b): jenis dokumen = master data SA; dokumen karyawan berversi & bermasa berlaku.
Enum employee.document_category {
  IDENTITY
  EDUCATION
  COMPETENCY
  HEALTH
  EMPLOYMENT
  FINANCE
  OTHER
}

Enum employee.document_requirement {
  NONE
  ALL
  SITE
  POSITIONS
}

Enum employee.document_status {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

Table employee.document_types {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(30) [not null, unique]
  name varchar(100) [not null]
  category employee.document_category [not null]
  has_expiry boolean [not null, default: false]
  default_validity_months int [note: '1–120 (CHECK)']
  reminder_days "int[]" [note: 'bawaan [60,30,7]']
  required_scope employee.document_requirement [not null, default: 'NONE']
  required_position_ids "uuid[]" [note: 'organization.positions.id, tanpa FK']
  multiple boolean [not null, default: false]
  employee_can_upload boolean [not null, default: false]
  sensitive boolean [not null, default: false, note: 'butuh grant employee.documents.read']
  max_size_mb int [not null, default: 5, note: '1–5 (CHECK)']
  allowed_mime_types "text[]"
  legacy_type varchar [unique, note: 'padanan enum lama wizard onboarding']
  sort_order int [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
  deleted_at timestamptz [note: 'diarsipkan']
}

Table employee.employee_documents {
  id uuid [pk, default: `gen_random_uuid()`]
  employee_id uuid [not null, ref: > employee.employees.id]
  type varchar [not null, note: 'enum lama (expand → contract)']
  document_type_id uuid [not null, ref: > employee.document_types.id]
  document_number varchar(60)
  issued_at date
  expires_at date [note: 'CHECK ≥ issued_at']
  version int [not null, default: 1]
  is_current boolean [not null, default: true]
  replaces_id uuid [ref: > employee.employee_documents.id, note: 'versi sebelumnya']
  status employee.document_status [not null, default: 'VERIFIED']
  verified_by uuid
  verified_at timestamptz
  note varchar(500)
  training_id uuid [ref: > employee.trainings.id, note: 'lampiran sertifikat']
  history_id uuid [ref: > employee.employment_histories.id, note: 'lampiran SK']
  storage_path varchar(255) [not null, unique, note: 'bucket private employee-documents']
  mime_type varchar(100) [not null]
  size_bytes int [not null]
  uploaded_by uuid [not null, note: 'iam.accounts.id, tanpa FK']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  indexes {
    (employee_id, document_type_id, is_current)
    expires_at [note: 'parsial: is_current & belum dihapus (cron document-expiry)']
  }
}

//// ---------- Skema: iam (D-028: satu akun satu role) ----------

Enum iam.role {
  SUPER_ADMIN
  HR_ADMIN
  MANAGER
  EMPLOYEE
}

Enum iam.permission {
  "employee.personal.read"
  "employee.personal.write"
  "employee.bank.read"
  "employee.bank.write"
  "employee.documents.read"
  "employee.documents.write"
  "contract.manage"
  "payroll.period.prepare"
}

Table iam.accounts {
  id uuid [pk, default: `gen_random_uuid()`]
  auth_user_id uuid [not null, unique, note: 'User Supabase Auth; tanpa FK (D-023)']
  employee_id uuid [unique, ref: - employee.employees.id, note: 'Nullable: SUPER_ADMIN boleh tanpa data karyawan']
  email varchar(254) [not null, unique]
  role iam.role [not null, note: 'Satu akun satu role (D-028)']
  is_active boolean [not null, default: true]
  is_primary_super_admin boolean [not null, default: false, note: 'Unik parsial: maks. satu; CHECK hanya SUPER_ADMIN']
  last_login_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    role
  }
}

Table iam.permission_grants {
  id uuid [pk, default: `gen_random_uuid()`]
  account_id uuid [not null, ref: > iam.accounts.id]
  permission iam.permission [not null]
  expires_at timestamptz
  reason text
  granted_by uuid [not null, ref: > iam.accounts.id]
  revoked_at timestamptz [note: 'CHECK: revoked_at & revoked_by diisi bersamaan']
  revoked_by uuid [ref: > iam.accounts.id]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    account_id
    granted_by
    revoked_by
  }
}

Table iam.account_companies {
  account_id uuid [not null, ref: > iam.accounts.id, note: 'ON DELETE CASCADE']
  company_id uuid [not null, ref: > organization.companies.id]
  assigned_by uuid [note: 'akun SUPER_ADMIN; null = migrasi/script']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (account_id, company_id) [pk]
    company_id
  }
  Note: 'D-040: cakupan perusahaan akun HR_ADMIN'
}

//// ---------- Skema: audit (core, append-only, tanpa FK) ----------

Table audit.audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_account_id uuid [note: 'Null = script/sistem']
  action varchar(100) [not null]
  entity_type varchar(50) [not null]
  entity_id varchar(100)
  before jsonb [note: 'Tanpa nilai sensitif mentah']
  after jsonb
  reason text
  request_id varchar(128)
  ip varchar(45)
  occurred_at timestamptz [not null, default: `now()`]

  indexes {
    actor_account_id
    (entity_type, entity_id)
    occurred_at
  }
}

//// ---------- Skema: notification (PLAN §5.6; tanpa FK ke iam, PLAN §3.2.3) ----------

Enum notification.email_outbox_status {
  PENDING
  SENT
  FAILED
}

Table notification.notifications {
  id uuid [pk, default: `gen_random_uuid()`]
  recipient_account_id uuid [not null, note: 'UUID iam.accounts, tanpa FK']
  type varchar(50) [not null]
  title varchar(200) [not null]
  body text [note: 'Tanpa data sensitif']
  link varchar(500)
  dedupe_key varchar(200) [note: 'Anti-duplikat cron, unik per penerima']
  read_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (recipient_account_id, dedupe_key) [unique]
    (recipient_account_id, read_at)
    created_at
  }
}

Table notification.email_outbox {
  id uuid [pk, default: `gen_random_uuid()`]
  to_email varchar(254) [not null]
  subject varchar(200) [not null]
  text_body text [not null]
  status notification.email_outbox_status [not null, default: 'PENDING']
  attempts int [not null, default: 0, note: 'FAILED setelah 5 percobaan']
  last_error varchar(500)
  next_attempt_at timestamptz
  sent_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (status, next_attempt_at)
  }
}

// D-042: jejak import karyawan (file TIDAK disimpan; masalah per baris tanpa nilai).
Table employee.import_jobs {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_account_id uuid [not null, note: 'akun pengimpor (tanpa FK lintas modul iam)']
  company_id uuid [ref: > organization.companies.id, note: 'PT bawaan']
  file_name varchar(255) [not null]
  file_sha256 varchar(64) [not null]
  mode employee.import_mode [not null]
  total_rows int [not null]
  created_count int [not null]
  updated_count int [not null]
  skipped_count int [not null]
  error_count int [not null]
  skipped_fields "text[]" [not null, note: 'kolom sensitif yang dilewati (tanpa grant)']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    actor_account_id
    company_id
    created_at
  }
}

Table employee.import_job_issues {
  id uuid [pk, default: `gen_random_uuid()`]
  job_id uuid [not null, ref: > employee.import_jobs.id, note: 'cascade']
  source_row int [not null]
  source_column varchar(10)
  field varchar(50)
  code varchar(50) [not null]
  severity employee.import_issue_severity [not null]

  indexes {
    job_id
  }
}

// D-060: antrean lampiran Google Drive dari Import (diproses bertahap setelah simpan).
Table employee.import_job_attachments {
  id uuid [pk, default: `gen_random_uuid()`]
  job_id uuid [not null, ref: > employee.import_jobs.id, note: 'cascade']
  employee_id uuid [not null, ref: > employee.employees.id, note: 'cascade']
  source_row int [not null]
  field varchar(50) [not null, note: 'field Import attach*']
  target varchar(50) [not null, note: 'PHOTO atau document_types.code']
  note varchar(200) [not null]
  document_number varchar(60)
  drive_file_ids "text[]" [not null, note: 'CHECK 1–10 ID']
  status employee.import_attachment_status [not null, default: 'PENDING']
  reason varchar(300)
  source_sha256 varchar(64) [note: 'sidik jari file Drive; sama → dilewati']
  attempts smallint [not null, default: 0]
  document_id uuid [ref: > employee.employee_documents.id, note: 'set null']
  claimed_at timestamptz
  processed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (job_id, status)
    (employee_id, target)
    document_id
  }
}

Table employee.import_mappings {
  id uuid [pk, default: `gen_random_uuid()`]
  signature varchar(64) [not null, unique, note: 'SHA-256 susunan header']
  mapping jsonb [not null, note: 'header ternormalisasi → field']
  updated_by uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]
}
