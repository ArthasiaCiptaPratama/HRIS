{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hris.local/schemas/execution-result.json",
  "title": "ExecutionResult",
  "description": "Output of the Worker Agent — task execution results",
  "type": "object",
  "definitions": {
    "TaskResult": {
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "status": { "type": "string", "enum": ["success", "partial", "failed", "skipped"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "output": { "type": "string" },
        "filesCreated": { "type": "array", "items": { "type": "string" } },
        "filesModified": { "type": "array", "items": { "type": "string" } },
        "errors": { "type": "array", "items": { "type": "string" } },
        "skillUsed": { "type": "string" }
      },
      "required": ["taskId", "status", "startedAt"]
    }
  },
  "properties": {
    "missionId": { "type": "string", "format": "uuid" },
    "sessionId": { "type": "string", "format": "uuid" },
    "overallStatus": { "type": "string", "enum": ["success", "partial_success", "failed", "cancelled"] },
    "taskResults": { "type": "array", "items": { "$ref": "#/definitions/TaskResult" } },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "summary": { "type": "string" }
  },
  "required": ["missionId", "sessionId", "overallStatus", "taskResults", "startedAt"]
}
