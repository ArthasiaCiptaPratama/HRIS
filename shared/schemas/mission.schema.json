{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hris.local/schemas/mission-plan.json",
  "title": "MissionPlan",
  "description": "Output of the Mission Creator Agent — detailed executable plan",
  "type": "object",
  "definitions": {
    "FileOperation": {
      "type": "object",
      "properties": {
        "filePath": { "type": "string" },
        "operation": { "type": "string", "enum": ["create", "modify", "delete", "read"] },
        "purpose": { "type": "string" },
        "contentGuidance": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["filePath", "operation", "purpose"]
    },
    "SubTask": {
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "requiredSkills": { "type": "array", "items": { "type": "string" } },
        "fileOperations": { "type": "array", "items": { "$ref": "#/definitions/FileOperation" } },
        "successCriteria": { "type": "array", "items": { "type": "string" } },
        "estimatedComplexity": { "type": "string", "enum": ["trivial", "simple", "moderate", "complex", "epic"] },
        "dependsOn": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "failed", "skipped"] },
        "notes": { "type": "string" }
      },
      "required": ["taskId", "title", "description", "requiredSkills", "successCriteria", "status"]
    },
    "SkillManifestEntry": {
      "type": "object",
      "properties": {
        "skillId": { "type": "string" },
        "taskIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["skillId", "taskIds"]
    },
    "MissionMetadata": {
      "type": "object",
      "properties": {
        "missionId": { "type": "string", "format": "uuid" },
        "sessionId": { "type": "string", "format": "uuid" },
        "analysisId": { "type": "string", "format": "uuid" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "overallPriority": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "estimatedTasks": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["missionId", "sessionId", "analysisId", "title", "summary", "createdAt"]
    }
  },
  "properties": {
    "metadata": { "$ref": "#/definitions/MissionMetadata" },
    "tasks": { "type": "array", "items": { "$ref": "#/definitions/SubTask" } },
    "globalSuccessCriteria": { "type": "array", "items": { "type": "string" } },
    "fileManifest": { "type": "array", "items": { "$ref": "#/definitions/FileOperation" } },
    "skillManifest": { "type": "array", "items": { "$ref": "#/definitions/SkillManifestEntry" } },
    "executionPlan": { "type": "string", "enum": ["sequential", "parallel", "hybrid"] },
    "status": { "type": "string", "enum": ["draft", "approved", "in_progress", "completed", "failed", "cancelled"] },
    "creatorVersion": { "type": "string" }
  },
  "required": ["metadata", "tasks", "globalSuccessCriteria", "fileManifest", "executionPlan", "status"]
}
